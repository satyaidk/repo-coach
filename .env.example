# Copy this file to `.env` and fill in only what you use.

# --- GitHub -----------------------------------------------------------------
# Optional but recommended: raises the API limit from 60 to 5,000 requests/hour
# and lets you analyze private repos you have access to.
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# --- Which AI provider is selected by default in the UI ----------------------
# one of: ollama | openai | anthropic | gemini
DEFAULT_LLM_PROVIDER=ollama

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional: point at any OpenAI-compatible API (OpenRouter, Groq, LM Studio...)
OPENAI_BASE_URL=

# --- Anthropic (Claude) -------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Google Gemini ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (local) -----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Context window in tokens. Bigger = the model sees more of the repo, but needs more
# GPU memory. 8192 suits a 4 GB GPU; try 16384+ if you have 8 GB of VRAM or more.
# (`ollama ps` shows whether the model fits on your GPU: aim for "100% GPU".)
OLLAMA_NUM_CTX=8192
